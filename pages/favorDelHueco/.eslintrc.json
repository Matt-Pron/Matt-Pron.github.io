{
    "env": {
        "browser": true,
        "es2021": true
    },
    "extends": [
        "eslint:recommended",
        "plugin:@typescript-eslint/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "plugins": [
        "@typescript-eslint",
        "import"],
    "rules": {
        "eqeqeq" : ["error", "always"],
        "semi": ["error", "always"],
        "no-var" : ["error"],
        "prefer-const": ["error"],

        "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
        "prefer-template": ["warn"],
        "import/extensions": ["error", "always", { "ignorePackages": true }]
    }
}

