    handlePointer(type, gridX, gridY, localX, localY, event) {
        const direction = gridX < this.width / 2 ? "move_left" : "move_right";

        const centerX = Math.floor(this.width / 2);
        const startY = Math.floor((this.height - this.options.length - 3) / 2);

        this.options.forEach((opt, i) => {
            const optionY = startY + i + 3;
            const optionWidth = opt.length + 2;
            const startX = centerX - Math.floor(optionWidth / 2);

            if (gridY === optionY && gridX >= startX && gridX < startX + optionWidth) {
                switch (type) {
                    case "move":
                        if (i !== 5 && i !== 6 && i !== 7) this.sectionIndex = i;
                        break;
                    case "down":
                        this.sectionIndex = i;
                        if (this.sectionIndex >= 1 || this.sectionIndex <= 4) {
                            this.handleInput(direction);
                        }
                        this.handleInput("confirm");
                        break;
                }
            }
        });
    }

    drawContent(renderer) {
        const text = "NUEVA PARTIDA";

        let startX = Math.floor((this.width - text.length) / 2);
        const startY = Math.floor((this.height - this.options.length - 3) / 2);

        renderer.drawLocalText(text, startX, startY);

        this.options.forEach((opt, i) => {
            const color = i === this.sectionIndex ? 13 : 2;
            const prefix = i === this.sectionIndex ? "[ " : "  ";
            const suffix = i === this.sectionIndex ? " ]" : "  ";
            const option = prefix + opt + suffix;
            startX = Math.floor((this.width - option.length) / 2);
            renderer.drawLocalText(option, startX, startY + 3 + i, { color: color });
        });

        // preview
        renderer.drawLocalChar(this.chars[this.charIdx], (this.width - 1 >> 1), startY + 9, { color: this.availColors[this.colorIdx] });
    }

    async startGame() {
        const player = {
            name: this.charName,
            class: this.classes[this.classIdx],
            race: this.races[this.raceIdx],
            char: this.chars[this.charIdx],
            color: colors[this.availColors[this.colorIdx]]
        };
        Globals.player = player;
        Globals.gameState = new GameState(Globals.player);

        const worldViewport = new World(0, 0, this.width, this.height, 0);

        changeScene(worldViewport);
    }
